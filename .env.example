# Copy to .env and export before starting the services, or set these in your
# supervisor. Defaults match the lab setup produced by `npm run setup`.

# Proxy listener
# ZTA_HOST=127.0.0.1
# ZTA_PORT=8443

# Files (defaults are relative to the repository root)
# ZTA_CERT_DIR=./certs
# ZTA_DATA_DIR=./data
# ZTA_POLICY_FILE=./config/policy.json

# Posture service
# ZTA_POSTURE_URL=http://127.0.0.1:8450
# ZTA_POSTURE_HOST=127.0.0.1
# ZTA_POSTURE_TOKEN_FILE=./data/posture-token.txt
# ZTA_AGENT_TOKENS_FILE=./data/agent-tokens.json

# Behaviour
# ZTA_UPSTREAM_TIMEOUT_MS=15000
# ZTA_LOG_LEVEL=info
