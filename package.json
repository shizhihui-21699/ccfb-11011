    "agent": "node scripts/device-agent.ts",
    "demo": "node scripts/demo.ts",
    "test": "node --test tests/",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
