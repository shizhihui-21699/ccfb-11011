  "private": true,
  "description": "Zero-trust access proxy with mTLS device identity, posture checks and revocable sessions",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "dev": "node scripts/dev.ts",
