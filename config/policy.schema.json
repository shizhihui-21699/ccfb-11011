{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zero Trust access policy",
  "type": "object",
  "required": [
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer"
    },
    "defaultDenyReason": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "effect",
          "apps"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "effect": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "description": {
            "type": "string"
          },
          "apps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "users": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deviceGroups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deviceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requireDiskEncrypted": {
            "type": "boolean"
          },
          "requireEdrOnline": {
            "type": "boolean"
          },
          "requireFirewall": {
            "type": "boolean"
          },
          "osFamilies": {
            "type": "array",
            "items": {
              "enum": [
                "macos",
                "windows",
                "linux"
              ]
            }
          },
          "minOsVersion": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^v?\\d+(\\.\\d+)*$"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "macos": {
                    "type": "string",
                    "pattern": "^v?\\d+(\\.\\d+)*$"
                  },
                  "windows": {
                    "type": "string",
                    "pattern": "^v?\\d+(\\.\\d+)*$"
                  },
                  "linux": {
                    "type": "string",
                    "pattern": "^v?\\d+(\\.\\d+)*$"
                  }
                }
              }
            ]
          },
          "maxPostureAgeSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "allowMissingPosture": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
